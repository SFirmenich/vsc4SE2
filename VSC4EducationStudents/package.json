{
  "name": "vsc4se2-student",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.0.10",
  "publisher": "SDFZ",
  "license": "MIT",
  "engines": {
    "vscode": "^1.114.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:learningActivity.loadFromZip",
    "onCommand:learningActivity.loadFromUrl",
    "onCommand:learningActivity.openPanel",
    "onCommand:learningActivity.registerStudent",
    "onCommand:learningActivity.startTask",
    "onCommand:learningActivity.finishTask",
    "onCommand:learningActivity.exportSubmission",
    "onCommand:learningActivity.closeSession",
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "learningActivity.loadFromZip",
        "title": "%command.loadFromZip%"
      },
      {
        "command": "learningActivity.loadFromUrl",
        "title": "%command.loadFromUrl%"
      },
      {
        "command": "learningActivity.openPanel",
        "title": "%command.openPanel%"
      },
      {
        "command": "learningActivity.registerStudent",
        "title": "%command.registerStudent%"
      },
      {
        "command": "learningActivity.startTask",
        "title": "%command.startTask%"
      },
      {
        "command": "learningActivity.finishTask",
        "title": "%command.finishTask%"
      },
      {
        "command": "learningActivity.exportSubmission",
        "title": "%command.exportSubmission%"
      },
      {
        "command": "learningActivity.closeSession",
        "title": "%command.closeSession%"
      }
    ],
    "configuration": {
      "title": "%configuration.title%",
      "properties": {
        "learningActivity.heartbeatIntervalSeconds": {
          "type": "number",
          "default": 30,
          "minimum": 5,
          "description": "%configuration.heartbeatIntervalSeconds%"
        },
        "learningActivity.autoOpenPanelAfterLoad": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.autoOpenPanelAfterLoad%"
        },
        "learningActivity.enableGitIntegration": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.enableGitIntegration%"
        },
        "learningActivity.trackTextChanges": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.trackTextChanges%"
        },
        "learningActivity.trackTerminalOpen": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.trackTerminalOpen%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run example:zip && npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test",
    "example:zip": "node scripts/create-example-zip.js"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.114.0",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^3.1.0",
    "esbuild": "^0.27.3",
    "eslint": "^9.39.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.1"
  },
  "dependencies": {
    "adm-zip": "^0.5.17"
  }
}

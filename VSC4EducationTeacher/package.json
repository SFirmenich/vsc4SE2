{
  "name": "learning-activity-tracker-teacher",
  "displayName": "%extension.displayName%",
  "description": "%extension.description%",
  "version": "0.1.0",
  "publisher": "vsc4education",
  "license": "MIT",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "onCommand:teacherActivity.openPanel",
    "onCommand:teacherActivity.openCreationMode",
    "onCommand:teacherActivity.openRevisionMode"
  ],
  "main": "./out/src/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "teacherActivity.openCreationMode",
        "title": "%command.openCreationMode%"
      },
      {
        "command": "teacherActivity.openRevisionMode",
        "title": "%command.openRevisionMode%"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src test --ext .ts",
    "test": "npm run compile-tests && mocha \"out/test/**/*.test.js\"",
    "compile-tests": "tsc -p tsconfig.test.json",
    "package": "vsce package"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.7",
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "@typescript-eslint/eslint-plugin": "^8.18.0",
    "@typescript-eslint/parser": "^8.18.0",
    "@vscode/vsce": "^3.2.1",
    "eslint": "^8.57.1",
    "mocha": "^11.0.1",
    "typescript": "^5.7.2"
  }
}

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Learning Activity Tracker - Teacher",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}",
        "--extensions-dir=${env:USERPROFILE}/.vscode/extensions"
      ],
      "outFiles": ["${workspaceFolder}/out/**/*.js"],
      "preLaunchTask": "npm: compile"
    }
  ]
}

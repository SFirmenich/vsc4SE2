{
  "name": "vsc4education-repository-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for VSCode4Education Repository",
  "main": "src/main.js",
  "scripts": {
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder"
  },
  "dependencies": {},
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "edu.vsc4education.repository",
    "productName": "VSCode4Education Repository",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "package.json",
      {
        "from": "../frontend/dist",
        "to": "frontend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "extraResources": [
      {
        "from": "../backend/dist/vsc4education-repository-backend",
        "to": "backend",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
